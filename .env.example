# Local-only PostgreSQL values. Change these before using any shared environment.
POSTGRES_USER=spa
POSTGRES_PASSWORD=spa_local_dev_only
POSTGRES_DB=spa_platform
POSTGRES_PORT=5432
DATABASE_URL=postgresql://spa:spa_local_dev_only@localhost:5432/spa_platform

# API and web development ports
PORT=5000
API_PORT=5000
WEB_PORT=5173
BASE_PATH=/
# Set to the number of trusted reverse proxies in front of the API (0 for local dev).
TRUST_PROXY_HOPS=0

# Clerk: use matching keys from your Clerk development instance.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
VITE_CLERK_PROXY_URL=

# Email is disabled by default. Configure SMTP before enabling it.
EMAIL_PROVIDER=disabled
PUBLIC_APP_URL=http://localhost:5173
# Generate a private random value with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
GUEST_BOOKING_MANAGEMENT_SECRET=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
LOG_LEVEL=info
