{
  "name": "spa-platform",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @workspace/api-server --filter @workspace/spa-platform run dev",
    "build": "pnpm --filter @workspace/api-server run build && pnpm --filter @workspace/spa-platform run build",
    "typecheck:libs": "tsc --build api/src/db/tsconfig.json api/src/contracts/tsconfig.json web/lib/api-client-react/tsconfig.json",
    "typecheck": "pnpm run typecheck:libs && pnpm --filter @workspace/api-server run typecheck && pnpm --filter @workspace/spa-platform run typecheck",
    "db:push": "pnpm --filter @workspace/db run push",
    "db:init": "pnpm --filter @workspace/api-server run init-db",
    "seed": "pnpm --filter @workspace/api-server run seed",
    "seed:accounts": "pnpm --filter @workspace/api-server run seed-accounts",
    "grant-role": "pnpm --filter @workspace/api-server run grant-role --"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}